        {
          "snapshotId": "snapshot:repo-ff10757cc0a66e40c305:c7b99075d91bbc09c0b92a14",
          "path": "src/vs/base/common/lifecycle.ts",
          "symbolId": "symbol:WyJmaWxlOmFkMzE5MWNhN2NmOWEwZWZjOWEzMWI2ZSIsIk1hbmRhdG9yeU11dGFibGVEaXNwb3NhYmxlIiwiY2xhc3MiLCJzcmMudnMuYmFzZS5jb21tb24ubGlmZWN5Y2xlIiw2MTUsMF0",
          "symbol": "src.vs.base.common.lifecycle.MandatoryMutableDisposable",
          "startLine": 615,
          "endLine": 638,
          "startByte": 17649,
          "endByte": 18173,
          "blobDigest": "b3a6d95573810fea6150288f56c661e93e5069b37cf9774d295be8926c7600ef",
          "source": "export class MandatoryMutableDisposable<T extends IDisposable> implements IDisposable {\n\tprivate readonly _disposable = new MutableDisposable<T>();\n\tprivate _isDisposed = false;\n\n\tconstructor(initialValue: T) {\n\t\tthis._disposable.value = initialValue;\n\t}\n\n\tget value(): T {\n\t\treturn this._disposable.value!;\n\t}\n\n\tset value(value: T) {\n\t\tif (this._isDisposed || value === this._disposable.value) {\n\t\t\treturn;\n\t\t}\n\t\tthis._disposable.value = value;\n\t}\n\n\tdispose() {\n\t\tthis._isDisposed = true;\n\t\tthis._disposable.dispose();\n\t}\n}",
          "kind": "source"
        },
