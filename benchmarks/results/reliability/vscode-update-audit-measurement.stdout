          "source": "function setGitHubContext(gitAPI: API, disposables: DisposableStore) {\n\tif (gitAPI.repositories.find(repo => repositoryHasGitHubRemote(repo))) {\n\t\tcommands.executeCommand('setContext', 'github.hasGitHubRepo', true);\n\t} else {\n\t\tconst openRepoDisposable = gitAPI.onDidOpenRepository(async e => {\n\t\t\tawait e.status();\n\t\t\tif (repositoryHasGitHubRemote(e)) {\n\t\t\t\tcommands.executeCommand('setContext', 'github.hasGitHubRepo', true);\n\t\t\t\topenRepoDisposable.dispose();\n\t\t\t}\n\t\t});\n\t\tdisposables.add(openRepoDisposable);\n\t}\n}",
          "kind": "source"
        },
        {
          "snapshotId": "snapshot:repo-ff10757cc0a66e40c305:c7b99075d91bbc09c0b92a14",
          "path": "extensions/github/src/util.ts",
          "symbolId": "symbol:WyJmaWxlOjdjNTMyODVlOTY4ZDg1MTYzMWJlMDgxYiIsImRpc3Bvc2UiLCJtZXRob2QiLCJleHRlbnNpb25zLmdpdGh1Yi5zcmMudXRpbC5EaXNwb3NhYmxlU3RvcmUiLDE3LDFd",
          "symbol": "extensions.github.src.util.DisposableStore.dispose",
          "startLine": 17,
          "endLine": 23,
          "startByte": 606,
          "endByte": 731,
          "blobDigest": "2ae7dfe0b2b64d19791dc9b6310d68afd9dc26f79a045b12fe562e4b322b6872",
          "source": "dispose(): void {\n\t\tfor (const disposable of this.disposables) {\n\t\t\tdisposable.dispose();\n\t\t}\n\n\t\tthis.disposables.clear();\n\t}",
          "kind": "source"
        }
      ]
