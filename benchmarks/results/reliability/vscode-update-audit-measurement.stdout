      "evidence": [
        {
          "snapshotId": "snapshot:repo-ff10757cc0a66e40c305:c7b99075d91bbc09c0b92a14",
          "path": "extensions/github/src/util.ts",
          "symbolId": "symbol:WyJmaWxlOjdjNTMyODVlOTY4ZDg1MTYzMWJlMDgxYiIsIkRpc3Bvc2FibGVTdG9yZSIsImNsYXNzIiwiZXh0ZW5zaW9ucy5naXRodWIuc3JjLnV0aWwiLDksMF0",
          "symbol": "extensions.github.src.util.DisposableStore",
          "startLine": 9,
          "endLine": 24,
          "startByte": 435,
          "endByte": 733,
          "blobDigest": "2ae7dfe0b2b64d19791dc9b6310d68afd9dc26f79a045b12fe562e4b322b6872",
          "source": "export class DisposableStore {\n\n\tprivate disposables = new Set<vscode.Disposable>();\n\n\tadd(disposable: vscode.Disposable): void {\n\t\tthis.disposables.add(disposable);\n\t}\n\n\tdispose(): void {\n\t\tfor (const disposable of this.disposables) {\n\t\t\tdisposable.dispose();\n\t\t}\n\n\t\tthis.disposables.clear();\n\t}\n}",
          "kind": "source"
        },
        {
          "snapshotId": "snapshot:repo-ff10757cc0a66e40c305:c7b99075d91bbc09c0b92a14",
          "path": "extensions/typescript-language-features/src/utils/dispose.ts",
          "symbolId": "symbol:WyJmaWxlOjJiYTE2ODYwMzUzMWFkMTA3ODFhMjU1YiIsIkRpc3Bvc2FibGVTdG9yZSIsImNsYXNzIiwiZXh0ZW5zaW9ucy50eXBlc2NyaXB0LWxhbmd1YWdlLWZlYXR1cmVzLnNyYy51dGlscy5kaXNwb3NlIiw1OCwwXQ",
          "symbol": "extensions.typescript-language-features.src.utils.dispose.DisposableStore",
          "startLine": 58,
          "endLine": 65,
          "startByte": 1317,
          "endByte": 1479,
          "blobDigest": "181b13edc5d4d14934fe84953c8b9b09bac7b7df84b09ac23c3f5f2557bff378",
          "source": "export class DisposableStore extends Disposable {\n\n\tpublic add<T extends IDisposable>(disposable: T): T {\n\t\tthis._register(disposable);\n\n\t\treturn disposable;\n\t}\n}",
          "kind": "source"
        },
        {
          "snapshotId": "snapshot:repo-ff10757cc0a66e40c305:c7b99075d91bbc09c0b92a14",
          "path": "src/vs/base/common/lifecycle.ts",
          "symbolId": "symbol:WyJmaWxlOmFkMzE5MWNhN2NmOWEwZWZjOWEzMWI2ZSIsIkRpc3Bvc2FibGVTdG9yZSIsImNsYXNzIiwic3JjLnZzLmJhc2UuY29tbW9uLmxpZmVjeWNsZSIsNDA5LDBd",
          "symbol": "src.vs.base.common.lifecycle.DisposableStore",
          "startLine": 409,
          "endLine": 468,
          "startByte": 12851,
          "endByte": 14104,
          "blobDigest": "b3a6d95573810fea6150288f56c661e93e5069b37cf9774d295be8926c7600ef",
          "source": "export class DisposableStore implements IDisposable {\n\n\tstatic DISABLE_DISPOSED_WARNING = false;\n\n\tprivate readonly _toDispose = new Set<IDisposable>();\n\tprivate _isDisposed = false;\n\n\tconstructor() {\n\t\ttrackDisposable(this);\n\t}\n\n\t/**\n\t * Dispose of all registered disposables and mark this object as disposed.\n\t *\n\t * Any future disposables added to this object will be disposed of on `add`.\n\t */\n\tpublic dispose(): void {\n\t\tif (this._isDisposed) {\n\t\t\treturn;\n\t\t}\n\n\t\tmarkAsDisposed(this);\n\t\tthis._isDisposed = true;\n\t\tthis.clear();\n\t}\n\n\t/**\n\t * @return `true` if this object has been disposed of.\n\t */\n\tpublic get isDisposed(): boolean {\n\t\treturn this._isDisposed;\n\t}\n\n\t/**\n\t * Dispose of all registered disposables but do not mark this object as disposed.\n\t */\n\tpublic clear(): void {\n\t\tif (this._toDispose.size === 0) {\n\t\t\treturn;\n\t\t}\n\n\t\ttry {\n\t\t\tdispose(this._toDispose);\n\t\t} finally {\n\t\t\tthis._toDispose.clear();\n\t\t}\n\t}\n\n\t/**\n\t * Add a new {@link IDisposable disposable} to the collection.\n\t */\n\tpublic add<T extends IDisposable>(o: T): T {\n\t\tif (!o || o === Disposable.None) {\n\t\t\treturn o;\n\t\t}\n\t\tif ((o as unknown as DisposableStore) === this) {\n\t\t\tthrow new Error('Cannot register a disposable on itself!');\n\t\t}\n\n\t\tsetParentOfDisposable(o, this);",
          "kind": "source"
        },
        {
