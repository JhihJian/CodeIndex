          "endByte": 4347,
          "blobDigest": "63cdbaf2e99744b3825b8809dc3d55b14071015d394293c462edf274b6d27fb6",
          "source": "PyAPI_FUNC(PyObject*) PyUnicode_FromStringAndSize(\n    const char *u,             /* UTF-8 encoded string */\n    Py_ssize_t size            /* size of buffer */\n    );",
          "kind": "source"
        }
