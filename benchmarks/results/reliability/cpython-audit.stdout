          "blobDigest": "8a1d516c404e991c04f6ca7c7532be4e2abb45518122fdac724a05f710a94697",
          "source": "def heappushpop(heap, item):\n    \"\"\"Fast version of a heappush followed by a heappop.\"\"\"\n    if heap and heap[0] < item:\n        item, heap[0] = heap[0], item\n        _siftup(heap, 0)\n    return item",
          "kind": "source"
        },
