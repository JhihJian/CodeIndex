          "path": "Lib/argparse.py",
          "symbolId": "symbol:WyJmaWxlOjIwNWVmMjRjOTM3NDQ2NWJmMzVjMzU5YSIsIl93YXJuaW5nIiwibWV0aG9kIiwiTGliLmFyZ3BhcnNlLkFyZ3VtZW50UGFyc2VyIiwyNzczLDRd",
          "symbol": "Lib.argparse.ArgumentParser._warning",
          "startLine": 2773,
          "endLine": 2775,
          "startByte": 105653,
          "endByte": 105823,
          "blobDigest": "c2cd895b117dbc4d55439773e3f11e57b833b1e20f05d311c4465b794b044898",
          "source": "def _warning(self, message):\n        args = {'prog': self.prog, 'message': message}\n        self._print_message(_('%(prog)s: warning: %(message)s\\n') % args, _sys.stderr)",
          "kind": "source"
        },
        {
          "snapshotId": "snapshot:repo-f8f2bc9a9817654ebd1b:9adae9b967fdb7f58175ef5d",
          "path": "Lib/argparse.py",
          "symbolId": "symbol:WyJmaWxlOjIwNWVmMjRjOTM3NDQ2NWJmMzVjMzU5YSIsIl9nZXRfa3dhcmdzIiwibWV0aG9kIiwiTGliLmFyZ3BhcnNlLkFyZ3VtZW50UGFyc2VyIiwxOTMxLDRd",
          "symbol": "Lib.argparse.ArgumentParser._get_kwargs",
          "startLine": 1931,
          "endLine": 1940,
          "startByte": 70153,
          "endByte": 70421,
          "blobDigest": "c2cd895b117dbc4d55439773e3f11e57b833b1e20f05d311c4465b794b044898",
          "source": "def _get_kwargs(self):\n        names = [\n            'prog',\n            'usage',\n            'description',\n            'formatter_class',\n            'conflict_handler',\n            'add_help',\n        ]\n        return [(name, getattr(self, name)) for name in names]",
          "kind": "source"
        },
        {
          "snapshotId": "snapshot:repo-f8f2bc9a9817654ebd1b:9adae9b967fdb7f58175ef5d",
          "path": "Lib/argparse.py",
          "symbolId": "symbol:WyJmaWxlOjIwNWVmMjRjOTM3NDQ2NWJmMzVjMzU5YSIsImZvcm1hdF91c2FnZSIsIm1ldGhvZCIsIkxpYi5hcmdwYXJzZS5Bcmd1bWVudFBhcnNlciIsMjY5NSw0XQ",
          "symbol": "Lib.argparse.ArgumentParser.format_usage",
          "startLine": 2695,
          "endLine": 2699,
          "startByte": 103271,
          "endByte": 103491,
          "blobDigest": "c2cd895b117dbc4d55439773e3f11e57b833b1e20f05d311c4465b794b044898",
          "source": "def format_usage(self):\n        formatter = self._get_formatter()\n        formatter.add_usage(self.usage, self._actions,\n                            self._mutually_exclusive_groups)\n        return formatter.format_help()",
          "kind": "source"
        },
        {
          "snapshotId": "snapshot:repo-f8f2bc9a9817654ebd1b:9adae9b967fdb7f58175ef5d",
          "path": "Lib/argparse.py",
          "symbolId": "symbol:WyJmaWxlOjIwNWVmMjRjOTM3NDQ2NWJmMzVjMzU5YSIsImZvcm1hdF9oZWxwIiwibWV0aG9kIiwiTGliLmFyZ3BhcnNlLkFyZ3VtZW50UGFyc2VyIiwyNzAxLDRd",
          "symbol": "Lib.argparse.ArgumentParser.format_help",
          "startLine": 2701,
          "endLine": 2722,
          "startByte": 103497,
          "endByte": 104224,
          "blobDigest": "c2cd895b117dbc4d55439773e3f11e57b833b1e20f05d311c4465b794b044898",
          "source": "def format_help(self):\n        formatter = self._get_formatter()\n\n        # usage\n        formatter.add_usage(self.usage, self._actions,\n                            self._mutually_exclusive_groups)\n\n        # description\n        formatter.add_text(self.description)\n\n        # positionals, optionals and user-defined groups\n        for action_group in self._action_groups:\n            formatter.start_section(action_group.title)\n            formatter.add_text(action_group.description)\n            formatter.add_arguments(action_group._group_actions)\n            formatter.end_section()\n\n        # epilog\n        formatter.add_text(self.epilog)\n\n        # determine help from format above\n        return formatter.format_help()",
          "kind": "source"
        },
        {
          "snapshotId": "snapshot:repo-f8f2bc9a9817654ebd1b:9adae9b967fdb7f58175ef5d",
          "path": "Lib/argparse.py",
          "symbolId": "symbol:WyJmaWxlOjIwNWVmMjRjOTM3NDQ2NWJmMzVjMzU5YSIsIl9nZXRfZm9ybWF0dGVyIiwibWV0aG9kIiwiTGliLmFyZ3BhcnNlLkFyZ3VtZW50UGFyc2VyIiwyNzI0LDRd",
          "symbol": "Lib.argparse.ArgumentParser._get_formatter",
          "startLine": 2724,
          "endLine": 2727,
          "startByte": 104230,
          "endByte": 104378,
          "blobDigest": "c2cd895b117dbc4d55439773e3f11e57b833b1e20f05d311c4465b794b044898",
          "source": "def _get_formatter(self):\n        formatter = self.formatter_class(prog=self.prog)\n        formatter._set_color(self.color)\n        return formatter",
          "kind": "source"
        },
        {
          "snapshotId": "snapshot:repo-f8f2bc9a9817654ebd1b:9adae9b967fdb7f58175ef5d",
          "path": "Lib/argparse.py",
          "symbolId": "symbol:WyJmaWxlOjIwNWVmMjRjOTM3NDQ2NWJmMzVjMzU5YSIsImFkZF9zdWJwYXJzZXJzIiwibWV0aG9kIiwiTGliLmFyZ3BhcnNlLkFyZ3VtZW50UGFyc2VyIiwxOTQ2LDRd",
          "symbol": "Lib.argparse.ArgumentParser.add_subparsers",
          "startLine": 1946,
          "endLine": 1977,
          "startByte": 70551,
          "endByte": 71960,
          "blobDigest": "c2cd895b117dbc4d55439773e3f11e57b833b1e20f05d311c4465b794b044898",
          "source": "def add_subparsers(self, **kwargs):\n        if self._subparsers is not None:\n            raise ValueError('cannot have multiple subparser arguments')\n\n        # add the parser class to the arguments if it's not present\n        kwargs.setdefault('parser_class', type(self))\n\n        if 'title' in kwargs or 'description' in kwargs:\n            title = kwargs.pop('title', _('subcommands'))\n            description = kwargs.pop('description', None)\n            self._subparsers = self.add_argument_group(title, description)\n        else:\n            self._subparsers = self._positionals\n\n        # prog defaults to the usage message of this parser, skipping\n        # optional arguments and with no \"usage:\" prefix\n        if kwargs.get('prog') is None:\n            formatter = self._get_formatter()\n            positionals = self._get_positional_actions()\n            groups = self._mutually_exclusive_groups\n            formatter.add_usage(None, positionals, groups, '')\n            kwargs['prog'] = formatter.format_help().strip()\n\n        # create the parsers action and add it to the positionals list\n        parsers_class = self._pop_action_class(kwargs, 'parsers')\n        action = parsers_class(option_strings=[], **kwargs)\n        action._color = self.color\n        self._check_help(action)\n        self._subparsers._add_action(action)\n\n        # return the created parsers action\n        return action",
          "kind": "source"
        },
        {
          "snapshotId": "snapshot:repo-f8f2bc9a9817654ebd1b:9adae9b967fdb7f58175ef5d",
          "path": "Lib/argparse.py",
          "symbolId": "symbol:WyJmaWxlOjIwNWVmMjRjOTM3NDQ2NWJmMzVjMzU5YSIsIl9hZGRfYWN0aW9uIiwibWV0aG9kIiwiTGliLmFyZ3BhcnNlLkFyZ3VtZW50UGFyc2VyIiwxOTc5LDRd",
          "symbol": "Lib.argparse.ArgumentParser._add_action",
          "startLine": 1979,
          "endLine": 1984,
          "startByte": 71966,
          "endByte": 72164,
          "blobDigest": "c2cd895b117dbc4d55439773e3f11e57b833b1e20f05d311c4465b794b044898",
          "source": "def _add_action(self, action):\n        if action.option_strings:\n            self._optionals._add_action(action)\n        else:\n            self._positionals._add_action(action)\n        return action",
          "kind": "source"
        },
        {
          "snapshotId": "snapshot:repo-f8f2bc9a9817654ebd1b:9adae9b967fdb7f58175ef5d",
          "path": "Lib/argparse.py",
          "symbolId": "symbol:WyJmaWxlOjIwNWVmMjRjOTM3NDQ2NWJmMzVjMzU5YSIsIl9nZXRfb3B0aW9uYWxfYWN0aW9ucyIsIm1ldGhvZCIsIkxpYi5hcmdwYXJzZS5Bcmd1bWVudFBhcnNlciIsMTk4Niw0XQ",
          "symbol": "Lib.argparse.ArgumentParser._get_optional_actions",
          "startLine": 1986,
          "endLine": 1989,
          "startByte": 72170,
          "endByte": 72311,
          "blobDigest": "c2cd895b117dbc4d55439773e3f11e57b833b1e20f05d311c4465b794b044898",
          "source": "def _get_optional_actions(self):\n        return [action\n                for action in self._actions\n                if action.option_strings]",
          "kind": "source"
        }
